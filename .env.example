# By default, compose.yaml builds all services from their public GitHub repos
# (no local sibling clones needed). For local iteration, copy this to .env.local
# and add: COMPOSE_FILE=compose.yaml:compose.local.yaml
# That picks up compose.local.yaml, which overrides each build context to a
# sibling directory (../zt-frontend, ../nom-data-refiner, etc.).

DOMAIN_FRONTEND=tools.zenon.info
DOMAIN_API=api.tools.zenon.info
ACME_EMAIL=admin@zenon.info

POSTGRES_USER=nom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nom

# Pin a go-zenon git ref (tag or commit SHA) before deploying.
# See https://github.com/zenon-network/go-zenon/releases
ZNND_GIT_REF=v0.0.10

# Optional snapshot bootstrap. If set, znnd-bootstrap downloads, verifies, and
# extracts this zip into the znnd data volume on first boot (when /data/nom is
# absent). Leave blank to sync from genesis. The sibling .hash file (same URL,
# extension swapped) must contain the sha256.
ZNND_BOOTSTRAP_URL=https://hypercore.nyc3.digitaloceanspaces.com/bootstrap/2026-05-16/bootstrap-20260516010001.zip

# Set to "true" to force bootstrap even when /data/nom already exists. Existing
# nom/network/consensus dirs are moved aside with a timestamp suffix. Prefer
# the one-shot form for safety:
#   docker compose stop znnd
#   docker compose run --rm -e FORCE_BOOTSTRAP=true znnd-bootstrap
#   docker compose start znnd
ZNND_FORCE_BOOTSTRAP=false

# Etherscan API key. Used by eth-pool-indexer (consolidated on-chain reads
# for the WZNN/WETH Uniswap V2 pool). MUST be set or eth-pool-indexer fails
# to start. Free at https://etherscan.io/apis (100k calls/day).
ETHERSCAN_API_KEY=
ETH_POOL_REFRESH_SECONDS=300

# CoinGecko Demo API key. Per-key 30 calls/min, bypasses IP-based rate
# limits. Free at coingecko.com -> Developer Dashboard. Used by:
#   - nom-data-refiner via configs/refiner.config.json (coin_gecko_api_key)
#   - zt-frontend, baked into the SPA at Docker build time (this var)
# Leave empty to fall back to anonymous CoinGecko (rate-limit-prone).
COINGECKO_API_KEY=
